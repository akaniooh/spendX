{
  "name": "spendx",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SpendX: pay on any chain with any token, settled through NEAR Intents.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test \"shared/test/*.test.ts\" \"server/test/*.test.ts\" \"web/test/*.test.ts\"",
    "discover": "node --env-file-if-exists=.env scripts/discover.ts",
    "typecheck": "tsc -p .",
    "start": "node --env-file-if-exists=.env server/src/index.ts",
    "dev": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "db:check": "node --env-file-if-exists=.env scripts/db-check.ts",
    "ai:check": "node --env-file-if-exists=.env scripts/ai-check.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "@types/express": "^4.17.21",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "vite": "^6.0.0",
    "@vitejs/plugin-react": "^4.3.4"
  },
  "dependencies": {
    "@defuse-protocol/one-click-sdk-typescript": "^0.1.24",
    "@hot-labs/near-connect": "0.12.0",
    "@solana/web3.js": "^1.98.0",
    "@supabase/supabase-js": "^2.45.0",
    "express": "^4.21.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "viem": "^2.21.0"
  }
}
